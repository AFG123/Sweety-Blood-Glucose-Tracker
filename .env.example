# Database Configuration (Docker Compose & Backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=sweety_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS and cookies)
FRONTEND_URL=http://localhost:5173

# JWT & Cookie Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
COOKIE_SECRET=your_cookie_signing_secret_min_32_characters_long
CSRF_SECRET=your_csrf_secret_min_32_characters_long
